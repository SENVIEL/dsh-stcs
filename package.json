{
  "name": "dsh-stcs",
  "version": "0.1.2",
  "description": "STCS (ARTEX-style) penetration-test orchestration: self-contained host plugin, preset and Web UI.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./lib/plugin.js",
    "./artex": "./lib/artex/plugin.js",
    "./client": "./lib/ui-stcs.client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  }
}
